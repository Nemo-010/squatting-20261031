## auditd rules for proxy / tunnel / relay squatting.
## Install as /etc/audit/rules.d/50-proxyjack.rules then: augenrules --load
## Check the result: auditctl -l && auditctl -s   (lost must stay 0)
##
## Syntax traps that make this file useless if ignored:
##   * the architecture field is "arch", not "ar". A rule using -F ar fails with
##     "-F missing operation for ar", augenrules aborts after the leading -D has
##     already cleared the ruleset, and with -e 2 applied you cannot fix it until
##     reboot.
##   * -F path= is not recursive and needs the inode to exist at load time. Use
##     -F dir= for directories, which is a subtree watch.
##   * the io_uring filter takes no arch field and resolves -S against a fixed
##     opcode table in the audit userspace. Opcodes that are not in that table
##     abort the whole load. This file names only connect, sendmsg, openat and
##     openat2, which are in uringop_table.h. Do not add socket/send/recv: those
##     are marked audit_skip in io_uring/opdef.c and can never be audited.
## arch must precede -S as the field parser needs it for syscall numbering.

-D
-b 16384
--backlog_wait_time 120000
--loginuid-immutable
-f 1
-r 0

## socket() carries no saddr_fam; match the family in a0
## 2 = AF_INET, 10 = AF_INET6, 17 = AF_PACKET, 40 = AF_VSOCK, 44 = AF_XDP
-a always,exit -F arch=b64 -S socket -F a0=2  -k net_socket
-a always,exit -F arch=b64 -S socket -F a0=10 -k net_socket
-a always,exit -F arch=b64 -S socket -F a0=17 -k raw_socket
-a always,exit -F arch=b64 -S socket -F a0=40 -k vsock_socket
-a always,exit -F arch=b64 -S socket -F a0=44 -k xdp_socket

## connections, both families.
## saddr_fam is populated by audit_sockaddr(), reached from move_addr_to_kernel():
## bind() and connect() always, sendto() when an address is supplied, and
## sendmsg() only when msg_name is non-NULL. A connected sendmsg therefore does
## not match these rules: the data plane needs a kprobe or the egress counter.
-a always,exit -F arch=b64 -S connect,bind -F saddr_fam=2  -k net_conn
-a always,exit -F arch=b64 -S connect,bind -F saddr_fam=10 -k net_conn
-a always,exit -F arch=b64 -S sendto,sendmsg -F saddr_fam=2  -k udp_conn
-a always,exit -F arch=b64 -S sendto,sendmsg -F saddr_fam=10 -k udp_conn

## 32-bit payloads have different syscall numbers and match none of the above.
## These are cheap to add and fire only for 32-bit processes.
-a always,exit -F ar -S socket -F a0=2  -k net_socket
-a always,exit -F ar -S socket -F a0=10 -k net_socket
-a always,exit -F ar -S connect,bind -F saddr_fam=2  -k net_conn
-a always,exit -F ar -S connect,bind -F saddr_fam=10 -k net_conn
-a always,exit -F ar -S sendto,sendmsg -F saddr_fam=2  -k udp_conn
-a always,exit -F ar -S sendto,sendmsg -F saddr_fam=10 -k udp_conn
-a always,exit -F ar -S memfd_create -k memfd
-a always,exit -F ar -S execveat -k execveat

## tunnel/VPN interface creation: ioctl(fd, TUNSETIFF, &ifr) = 0x400454ca
## WireGuard is NOT covered: wg interfaces are created over rtnetlink
## (RTM_NEWLINK), not TUNSETIFF. See HARDENING.md, D18.
-a always,exit -F arch=b64 -S ioctl -F a1=0x400454ca -k tun_ioctl

## network and user namespaces.
## CLONE_NEWNET = 0x40000000, CLONE_NEWUSER = 0x10000000.
## clone3() cannot be filtered: its flags are inside a struct behind a pointer,
## and a blanket -S clone3 floods on every pthread_create on modern glibc.
## Use checks/probes.bt for the clone3 case; a commented rule is left here as a
## reminder, not as coverage.
-a always,exit -F arch=b64 -S clone  -F a0&0x40000000 -k ns_net
-a always,exit -F arch=b64 -S clone  -F a0&0x10000000 -k ns_user
-a always,exit -F arch=b64 -S unshare -F a0&0x40000000 -k ns_net
-a always,exit -F arch=b64 -S unshare -F a0&0x10000000 -k ns_user
## setns(fd, nstype) puts the type in a1, so the rule can be filtered. The old
## unfiltered -S setns,setns rule fired on every nsenter and every container start.
-a always,exit -F arch=b64 -S setns -F a1&0x40000000 -k ns_net
-a always,exit -F arch=b64 -S setns -F a1&0x10000000 -k ns_user

## anonymous-memory payloads. execveat is the syscall that actually runs them
## (fexecve, execveat with AT_EMPTY_PATH); its flags are in a4, which audit does
## not expose, so the rule records the exec without the flag.
-a always,exit -F arch=b64 -S memfd_create -k memfd
-a always,exit -F arch=b64 -S execveat -k execveat

## repointing /proc/<pid>/exe: prctl(PR_SET_MM, PR_SET_MM_EXE_FILE, fd, 0, 0)
## PR_SET_MM = 35, PR_SET_MM_EXE_FILE = 13, needs CAP_SYS_RESOURCE.
-a always,exit -F arch=b64 -S prctl -F a0=35 -F a1=13 -k prctl_exe

## bind-mount over a watched tree (watch marks are per inode; a later bind mount
## is a different inode at the same path)
-a always,exit -F arch=b64 -S mount,move_mount -k mount

## preload surface; replaces a -w /etc/ld.so.preload watch, which fails on a host
## where the file does not exist at rule-load time.
## A bind mount inside /etc truncates the subtree walk unless the watch was made
## with -q mount-point,subtree; the mount rule above is the independent check.
-a always,exit -F arch=b64 -F dir=/etc -F perm=wa -k etc_write

## persistence - dir= subtree, not path= on the directory itself
-a always,exit -F arch=b64 -F dir=/etc/cron.d -F perm=wa -k persist
-a always,exit -F arch=b64 -F dir=/var/spool/cron -F perm=wa -k persist
-a always,exit -F arch=b64 -F dir=/etc/systemd/system -F perm=wa -k persist
-a always,exit -F arch=b64 -F dir=/usr/lib/systemd/system -F perm=wa -k persist
-a always,exit -F arch=b64 -F dir=/etc/profile.d -F perm=wa -k persist
-a always,exit -F arch=b64 -F dir=/etc/ld.so.conf.d -F perm=wa -k persist
-a always,exit -F arch=b64 -F dir=/etc/pam.d -F perm=wa -k persist

## module load; boot-time loads predate these rules, and kernel.modules_disabled
## is a boot-time switch. See HARDENING.md, D22.
-a always,exit -F arch=b64 -S init_module,finit_module -k kmod

## eBPF program load: an eBPF program attached ahead of your probes is the
## userland-invisible rootkit class. Noisy on hosts running container runtimes.
-a always,exit -F arch=b64 -S bpf -k bpf_load

## io_uring: the ring is created by io_uring_setup, and the network opcodes that
## the kernel makes auditable are connect, bind and sendmsg (socket/send/recv are
## audit_skip). bind is in the kernel but not yet in every uringop_table; it is
## deliberately omitted so this file cannot abort the load.
## Needs kernel >= 5.16 and audit userspace >= 3.1.
-a always,exit    -F arch=b64 -S io_uring_setup -k uring_setup
-a always,io_uring -S connect,sendmsg,openat,openat2 -k uring_net

## immutable until reboot. Must be last. Verify with auditctl -s; 'lost' must be 0
## at the moment of an alert, not only on a five-minute sweep.
-e 2